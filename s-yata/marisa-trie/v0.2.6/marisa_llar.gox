import (
	"os"
	"path/filepath"
)

const consumerSource = `#include "marisa.h"

#include <cstdlib>

int main() {
    int x = 100;
    int y = 200;

    marisa::swap(x, y);

    return EXIT_SUCCESS;
}
`

id "s-yata/marisa-trie"

// v0.2.6 is the first Conan-served tag with the verified CMake patch. The
// same patch applies to v0.2.7; v0.3.0 and later provide CMake upstream.
fromVer "v0.2.6"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
	"tools": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" && name != "tools" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	needsCMakePolicy := false

	// v0.2.6 and v0.2.7 need the exact Conan CMake patch; v0.3.0 and newer
	// already carry their own CMake build, so apply it only when absent.
	if _, err := os.stat(cmakeLists); os.isNotExist(err) {
		needsCMakePolicy = true
		patch := ctx.Proj.readFile("v0.2.6/0001-add-cmake.patch")!
		patchPath := filepath.join(ctx.SourceDir, "_llar_add_cmake.patch")
		os.writeFile(patchPath, patch, 0o644)!
		git! "-C", ctx.SourceDir, "apply", "--unidiff-zero", patchPath
	} else if err != nil {
		panic err
	}

	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	tools := target.options["tools"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	if needsCMakePolicy {
		c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	}
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "LIB_INSTALL_DIR", "lib"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "BUILD_TOOLS", tools
	c.defineBool "ENABLE_TOOLS", tools
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "COPYING.md"), os.readFile(filepath.join(ctx.SourceDir, "COPYING.md"))!, 0o644)!

	libs := ["-L$${libdir}", "-lmarisa"]
	osName := target.require["os"][0]
	if osName == "linux" || osName == "freebsd" {
		libs <- "-lm"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "Marisa",
		description = "Matching Algorithm with Recursively Implemented StorAge",
		version = "v0.2.6",
		libs = libs,
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "marisa.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("marisa")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "marisa.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("marisa")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}

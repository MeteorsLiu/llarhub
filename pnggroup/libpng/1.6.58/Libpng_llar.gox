import (
	"os"
	"strings"
)

id "pnggroup/libpng"

fromVer "v1.6.58"

onRequire (proj, deps) => {
	deps.require "madler/zlib", "v1.3.1"
}

onBuild (ctx, proj, out) => {
	installDir, err := ctx.outputDir()
	if err != nil {
		out.addErr err
		return
	}

	// Use configure so the dependency include directory stays a normal -I flag.
	// For example, CMake emits it as -isystem on macOS, where a host zlib.h can
	// override the zlib header used to generate pnglibconf.h.
	a := autotools.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)

	for _, dep := range proj.Deps {
		depDir, err := ctx.outputDir(dep)
		if err != nil {
			out.addErr err
			return
		}
		a.use depDir
	}

	err = a.configure("--disable-shared", "--enable-static", "--disable-tests", "--disable-tools")
	if err != nil {
		out.addErr err
		return
	}
	err = a.build()
	if err != nil {
		out.addErr err
		return
	}
	err = a.install()
	if err != nil {
		out.addErr err
		return
	}

	a.use installDir
	capout => {
		exec "pkg-config", "--static", "--libs", "libpng16"
	}
	if lastErr != nil {
		out.addErr lastErr
		return
	}
	out.setMetadata output
}

onTest (ctx, proj, out) => {
	installDir, err := ctx.outputDir()
	if err != nil {
		out.addErr err
		return
	}

	// Validate the installed package as an external C consumer.
	// Recreate the dependency environment because onTest may run after a cache hit.
	// For example, an install with png.h but no linkable libpng16.a must fail here.
	a := autotools.new("", "", "")
	for _, dep := range proj.Deps {
		depDir, err := ctx.outputDir(dep)
		if err != nil {
			out.addErr err
			return
		}
		a.use depDir
	}
	a.use installDir

	testSource := ctx.SourceDir + "/_llar_libpng_test.c"
	testBinary := ctx.SourceDir + "/_llar_libpng_test"
	// TODO: Move this source to a formula sidecar after source and formula files
	// have separate APIs. For example, onBuild currently reads formula files
	// while onRequire reads upstream source files through Project.ReadFile.
	testProgram := []byte(`#include <stdio.h>

#include <png.h>

int main(void) {
	if (png_access_version_number() == 0) {
		return 1;
	}
	puts("libpng consumer passed");
	return 0;
}
`)
	err = os.writeFile(testSource, testProgram, 0o644)
	if err != nil {
		out.addErr err
		return
	}

	capout => {
		exec "pkg-config", "--static", "--cflags", "--libs", "libpng16"
	}
	if lastErr != nil {
		out.addErr lastErr
		return
	}

	args := []string{testSource, "-o", testBinary}
	args = append(args, strings.fields(output)...)
	echo "Compiling libpng16 consumer"
	err = exec("cc", args...)
	if err != nil {
		out.addErr err
		return
	}

	echo "Running libpng16 consumer"
	err = exec(testBinary)
	if err != nil {
		out.addErr err
	}
}

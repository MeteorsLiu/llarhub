import (
	"os"
	"strings"
	"path/filepath"
	"slices"
)

const consumerC = `#include <tinyspline.h>

int main() {
  tsBSpline spline;
  tsStatus status;
  tsError error = ts_bspline_new(6, 3, 3, TS_OPENED, &spline, &status);
  ts_bspline_free(&spline);
  return error == TS_SUCCESS ? 0 : 1;
}
`

const consumerCXX = `#include <tinysplinecxx.h>

int main() {
  tinyspline::BSpline spline(6, 3, 3);
  return 0;
}
`

var sourcePatch = `--- src/CMakeLists.txt
+++ src/CMakeLists.txt
@@ -120,7 +120,7 @@
@@LLAR_CONTEXT@@# TINYSPLINE_DLANG_INTERMEDIATE_FILE
@@LLAR_CONTEXT@@#   Full path of D intermediate file.
@@LLAR_CONTEXT@@###############################################################################
-set(TINYSPLINE_OUTPUT_DIRECTORY $${CMAKE_BINARY_DIR}/lib CACHE INTERNAL "")
+set(TINYSPLINE_OUTPUT_DIRECTORY $${CMAKE_CURRENT_BINARY_DIR}/lib CACHE INTERNAL "")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# Generic no-config case (e.g. MinGW)
@@LLAR_CONTEXT@@set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_BACKUP $${CMAKE_RUNTIME_OUTPUT_DIRECTORY})
@@ -857,7 +857,7 @@
@@LLAR_CONTEXT@@	"-l$${TINYSPLINE_PKGCONFIG_C_LINK_LIBRARIES}")
@@LLAR_CONTEXT@@configure_file("$${CMAKE_CURRENT_SOURCE_DIR}/pkg/tinyspline.pc.in"
@@LLAR_CONTEXT@@	"$${TINYSPLINE_C_LIBRARY_OUTPUT_NAME}.pc" @ONLY)
-install(FILES "$${CMAKE_BINARY_DIR}/src/$${TINYSPLINE_C_LIBRARY_OUTPUT_NAME}.pc"
+install(FILES "$${CMAKE_CURRENT_BINARY_DIR}/$${TINYSPLINE_C_LIBRARY_OUTPUT_NAME}.pc"
@@LLAR_CONTEXT@@	DESTINATION "$${TINYSPLINE_INSTALL_PKGCONFIG_PATH}")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# C++ library
@@ -920,7 +920,7 @@
@@LLAR_CONTEXT@@		"-l$${TINYSPLINE_PKGCONFIG_CXX_LINK_LIBRARIES}")
@@LLAR_CONTEXT@@	configure_file("$${CMAKE_CURRENT_SOURCE_DIR}/pkg/tinysplinecxx.pc.in"
@@LLAR_CONTEXT@@		"$${TINYSPLINE_CXX_LIBRARY_OUTPUT_NAME}.pc" @ONLY)
-	install(FILES "$${CMAKE_BINARY_DIR}/src/$${TINYSPLINE_CXX_LIBRARY_OUTPUT_NAME}.pc"
+	install(FILES "$${CMAKE_CURRENT_BINARY_DIR}/$${TINYSPLINE_CXX_LIBRARY_OUTPUT_NAME}.pc"
@@LLAR_CONTEXT@@		DESTINATION "$${TINYSPLINE_INSTALL_PKGCONFIG_PATH}")
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@ -1073,7 +1073,7 @@
@@LLAR_CONTEXT@@			endif()
@@LLAR_CONTEXT@@		endif()
@@LLAR_CONTEXT@@		set(TINYSPLINE_MACOSX_RELINK_SCRIPT
-			"$${CMAKE_BINARY_DIR}/macosx-relink.sh")
+			"$${CMAKE_CURRENT_BINARY_DIR}/macosx-relink.sh")
@@LLAR_CONTEXT@@		configure_file(
@@LLAR_CONTEXT@@			"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/macosx-relink.sh.in"
@@LLAR_CONTEXT@@			$${TINYSPLINE_MACOSX_RELINK_SCRIPT}
@@ -1438,7 +1438,7 @@
@@LLAR_CONTEXT@@get_filename_component(TINYSPLINE_LIB_DIR $${TINYSPLINE_OUTPUT_DIRECTORY} NAME)
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# Dub
-file(REMOVE "$${CMAKE_BINARY_DIR}/dub.json")
+file(REMOVE "$${CMAKE_CURRENT_BINARY_DIR}/dub.json")
@@LLAR_CONTEXT@@if($${TINYSPLINE_WITH_DLANG})
@@LLAR_CONTEXT@@	set(TINYSPLINE_DUB_COPY_FILES "\"$${TINYSPLINE_LIB_DIR}/*.d\"")
@@LLAR_CONTEXT@@	set(TINYSPLINE_DUB_COPY_FILES "$${TINYSPLINE_DUB_COPY_FILES}\
@@ -1449,7 +1449,7 @@
@@LLAR_CONTEXT@@	endforeach()
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/dub.json.in"
-		"$${CMAKE_BINARY_DIR}/dub.json"
+		"$${CMAKE_CURRENT_BINARY_DIR}/dub.json"
@@LLAR_CONTEXT@@		@ONLY)
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@ -1479,12 +1479,12 @@
@@LLAR_CONTEXT@@		"tinyspline$${TINYSPLINE_LUAROCKS_SPEC}.rockspec")
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/tinyspline.rockspec.in"
-		"$${CMAKE_BINARY_DIR}/$${TINYSPLINE_LUAROCKS_SPEC}"
+		"$${CMAKE_CURRENT_BINARY_DIR}/$${TINYSPLINE_LUAROCKS_SPEC}"
@@LLAR_CONTEXT@@		@ONLY)
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# NuGet
-file(REMOVE "$${CMAKE_BINARY_DIR}/.nuspec")
+file(REMOVE "$${CMAKE_CURRENT_BINARY_DIR}/.nuspec")
@@LLAR_CONTEXT@@if($${TINYSPLINE_WITH_CSHARP})
@@LLAR_CONTEXT@@	get_filename_component(TINYSPLINE_NUGET_INTERFACE_FILE
@@LLAR_CONTEXT@@		$${TINYSPLINE_CSHARP_INTERFACE_FILE}
@@ -1531,21 +1531,21 @@
@@LLAR_CONTEXT@@	endforeach()
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/.nuspec.in"
-		"$${CMAKE_BINARY_DIR}/.nuspec"
+		"$${CMAKE_CURRENT_BINARY_DIR}/.nuspec"
@@LLAR_CONTEXT@@		@ONLY)
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# Maven
-file(REMOVE "$${CMAKE_BINARY_DIR}/pom.xml")
+file(REMOVE "$${CMAKE_CURRENT_BINARY_DIR}/pom.xml")
@@LLAR_CONTEXT@@if($${TINYSPLINE_WITH_JAVA})
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/pom.xml.in"
-		"$${CMAKE_BINARY_DIR}/pom.xml"
+		"$${CMAKE_CURRENT_BINARY_DIR}/pom.xml"
@@LLAR_CONTEXT@@		@ONLY)
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# Distutils
-file(REMOVE "$${CMAKE_BINARY_DIR}/setup.py")
+file(REMOVE "$${CMAKE_CURRENT_BINARY_DIR}/setup.py")
@@LLAR_CONTEXT@@if($${TINYSPLINE_WITH_PYTHON})
@@LLAR_CONTEXT@@	get_filename_component(TINYSPLINE_SETUP_INTERFACE_FILE
@@LLAR_CONTEXT@@		$${TINYSPLINE_PYTHON_INTERFACE_FILE}
@@ -1561,12 +1561,12 @@
@@LLAR_CONTEXT@@	set(TINYSPLINE_SETUP_FILE_ARRAY "[$${TINYSPLINE_SETUP_FILE_ARRAY}]")
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/setup.py.in"
-		"$${CMAKE_BINARY_DIR}/setup.py"
+		"$${CMAKE_CURRENT_BINARY_DIR}/setup.py"
@@LLAR_CONTEXT@@		@ONLY)
@@LLAR_CONTEXT@@endif()
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# Gem
-file(REMOVE "$${CMAKE_BINARY_DIR}/tinyspline.gemspec")
+file(REMOVE "$${CMAKE_CURRENT_BINARY_DIR}/tinyspline.gemspec")
@@LLAR_CONTEXT@@if($${TINYSPLINE_WITH_RUBY})
@@LLAR_CONTEXT@@	set(TINYSPLINE_RUBY_REQ_VERSION
@@LLAR_CONTEXT@@			"$${RUBY_VERSION_MAJOR}.$${RUBY_VERSION_MINOR}")
@@ -1578,7 +1578,7 @@
@@LLAR_CONTEXT@@	endforeach()
@@LLAR_CONTEXT@@	configure_file(
@@LLAR_CONTEXT@@		"$${CMAKE_CURRENT_SOURCE_DIR}/pkg/tinyspline.gemspec.in"
-		"$${CMAKE_BINARY_DIR}/tinyspline.gemspec"

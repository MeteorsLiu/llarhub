import "strings"

func normalize(version string) string {
	version = version.trimPrefix("v")
	version = strings.toLower(version)
	if strings.hasPrefix(version, "2.0.0.beta.") {
		version = strings.replace(version, "2.0.0.beta.", "2.0.0~beta.", 1)
	} else if version == "2.0.0.gm" {
		version = "2.0.0~gm"
	}
	return strings.replace(version, "-", "~", 1)
}

compareVer (a, b) => {
	return gnu.Compare(normalize(a.Version), normalize(b.Version))
}
